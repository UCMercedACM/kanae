{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "kanae"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64}|dev)$" },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "kanae": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granianWorkers"],
      "properties": {
        "granianWorkers": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    }
  }
}
