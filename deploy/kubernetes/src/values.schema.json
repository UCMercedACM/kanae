{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "serviceNames",
    "image",
    "kanae",
    "gateway",
    "postgres",
    "valkey",
    "ory",
    "migrate",
    "renderSecrets",
    "secrets"
  ],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*$" },
        "tag": { "$ref": "#/$defs/digest" }
      }
    },
    "secret": { "type": "string" },
    "serviceName": {
      "description": "RFC 1035 label. A dnsLabel that must begin with a letter, which Service names require.",
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "controllerResources": {
      "description": "Resources for a pod this chart does not render. Rule 7 is enforced by shape: limits holds memory only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": { "cpu": { "$ref": "#/$defs/cpu" }, "memory": { "$ref": "#/$defs/binarySize" } }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory"],
          "properties": { "memory": { "$ref": "#/$defs/binarySize" } }
        }
      }
    },
    "dnsLabel": {
      "description": "RFC 1123 label. Lowercase alphanumerics and dashes, starting and ending alphanumeric.",
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "description": "RFC 1123 subdomain: dnsLabels joined by dots. What Kubernetes requires of most object names.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
    },
    "cpu": {
      "description": "A CPU quantity, whole cores or millicores. Zero is not useful, so it is not allowed.",
      "type": "string",
      "pattern": "^[1-9][0-9]*m?$"
    },
    "binarySize": {
      "description": "A binary quantity. Kubernetes accepts decimal suffixes too, but this repository writes only these.",
      "type": "string",
      "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"
    },
    "digest": {
      "description": "A digest-pinned image tag. The digest is required: without one a rebuilt tag renders byte-identical, kapp sees no diff, and the pod keeps the old image.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*@sha256:[0-9a-f]{64}$"
    },
    "origin": {
      "description": "An RFC 6454 origin: scheme, host, optional port, nothing after. The host half is dnsSubdomain verbatim, so this takes exactly the hosts gateway.hostname takes, and a path, a trailing slash, an empty label or a dashed edge all fail. Ports over 65535 slip through, because capping them costs a six-branch alternation and catches nothing anyone would type.",
      "type": "string",
      "maxLength": 267,
      "pattern": "^https?://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[1-9][0-9]{0,4})?$"
    }
  },
  "properties": {
    "namespace": { "$ref": "#/$defs/dnsLabel" },
    "serviceNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kanae", "database", "valkey", "kratos", "keto"],
      "properties": {
        "kanae": { "$ref": "#/$defs/serviceName" },
        "database": { "$ref": "#/$defs/serviceName" },
        "valkey": { "$ref": "#/$defs/serviceName" },
        "kratos": { "$ref": "#/$defs/serviceName" },
        "keto": { "$ref": "#/$defs/serviceName" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*$" },
        "tag": {
          "description": "A digest-pinned tag for anything kapp applies, or the mutable dev and edge tags, which only the throwaway k3d cluster uses.",
          "anyOf": [{ "enum": ["dev", "edge"] }, { "$ref": "#/$defs/digest" }]
        },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "kanae": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granianWorkers", "allowedOrigins", "limiter"],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/origin" }
        },
        "limiter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "granianWorkers": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "hostname", "tls"],
      "properties": {
        "className": { "$ref": "#/$defs/dnsSubdomain" },
        "hostname": { "$ref": "#/$defs/dnsSubdomain" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "issuers"],
          "properties": {
            "provider": {
              "enum": ["acme", "selfSigned"],
              "description": "Which entry of issuers becomes the Issuer's spec. cert-manager calls this slot the provider."
            },
            "issuers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["acme", "selfSigned"],
              "properties": {
                "acme": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["server", "email", "privateKeySecretRef"],
                  "properties": {
                    "server": {
                      "description": "The ACME directory URL. Plain HTTP would hand the account key to anyone on the path.",
                      "type": "string",
                      "pattern": "^https://\\S+$"
                    },
                    "email": {
                      "description": "Where Let's Encrypt sends expiry warnings. Empty means no contact. WHATWG HTML email grammar.",
                      "type": "string",
                      "pattern": "^([a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*)?$"
                    },
                    "privateKeySecretRef": { "type": "object" }
                  }
                },
                "selfSigned": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "storageClass", "storage"],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "storageClass": { "$ref": "#/$defs/dnsSubdomain" },
        "storage": { "$ref": "#/$defs/binarySize" }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "maxmemory"],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "maxmemory": {
          "description": "Valkey's own size syntax, which is lowercase and decimal, not Kubernetes'.",
          "type": "string",
          "pattern": "^[1-9][0-9]*(kb|mb|gb)$"
        }
      }
    },
    "ory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secureCookies", "publicOrigin", "kratos", "keto"],
      "properties": {
        "secureCookies": { "type": "boolean" },
        "publicOrigin": { "$ref": "#/$defs/origin" },
        "kratos": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": { "image": { "$ref": "#/$defs/image" } }
        },
        "keto": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": { "image": { "$ref": "#/$defs/image" } }
        }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atlas"],
      "properties": {
        "atlas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": { "image": { "$ref": "#/$defs/image" } }
        }
      }
    },
    "renderSecrets": { "type": "boolean" },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dbPassword": { "$ref": "#/$defs/secret" },
        "valkeyPassword": { "$ref": "#/$defs/secret" },
        "kanaePassword": { "$ref": "#/$defs/secret" },
        "kratosPassword": { "$ref": "#/$defs/secret" },
        "ketoPassword": { "$ref": "#/$defs/secret" },
        "postgresMonitorPassword": { "$ref": "#/$defs/secret" },
        "kanaeMigratePassword": { "$ref": "#/$defs/secret" },
        "kratosMigratePassword": { "$ref": "#/$defs/secret" },
        "ketoMigratePassword": { "$ref": "#/$defs/secret" },
        "kratosSecretsCookie": { "$ref": "#/$defs/secret" },
        "kratosSecretsCipher": { "$ref": "#/$defs/secret" },
        "kratosWebhookMasterKey": { "$ref": "#/$defs/secret" },
        "kratosWebhookTokenRegistration": { "$ref": "#/$defs/secret" },
        "kratosWebhookTokenSettings": { "$ref": "#/$defs/secret" },
        "kratosSmtpUri": {
          "description": "An SMTP connection URI, or empty when the value is supplied at render time.",
          "type": "string",
          "pattern": "^(smtps?://\\S+)?$"
        },
        "storageKeyId": { "$ref": "#/$defs/secret" },
        "storageSecretKey": { "$ref": "#/$defs/secret" },
        "borgPassphrase": { "$ref": "#/$defs/secret" },
        "borgS3AccessKey": { "$ref": "#/$defs/secret" },
        "borgS3SecretKey": { "$ref": "#/$defs/secret" }
      }
    }
  }
}
