{
  "markdown": {
    "codeBlock.preserveIndentation": true,
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "lineWidth": 88
  },
  "yaml": {
    "quotes": "preferDouble",
    "indentBlockSequenceInMap": true,
    "preferSingleLine": false,
    "trailingComma": true,
    "formatComments": false,
    "proseWrap": "preserve",
    "associations": ["**/*.{yaml,yml}", "**/.yamllint"]
  },
  "json": {
    "lineWidth": 120
  },
  "dockerfile": {
    "indentWidth": 4
  },
  "sql": {
    "dialect": "postgresql",
    "casing": "upper",
    "indentWidth": 4
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [{
      "command": "shfmt -bn -ci",
      "exts": ["sh", "bats"]
    }]
  },
  "excludes": [
    "deploy/kubernetes/src/templates/**",
    "deploy/kubernetes/src/files/**",
    "deploy/kubernetes/dist/**",
    "**/*.sops.{yaml,yml}"
  ],
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/sql@0.4.1",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:@dprint/terraform@0.1.1",
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3"
  ]
}
